# ============================================
# Pi-hole + Unbound Docker Configuration
# ============================================

# --------------------------------------------
# Basic Configuration
# --------------------------------------------

# Hostname for the Pi-hole container
HOSTNAME=pihole

# Local domain name for your network
DOMAIN_NAME=scarlettlab.home

# Timezone for proper log rotation and timestamps
TZ=America/New_York

# --------------------------------------------
# Web Interface Settings
# --------------------------------------------

# Password for Pi-hole admin web interface
WEBPASSWORD=raspberry

# Web interface theme (options: default-light, default-dark, default-darker, etc.)
WEBTHEME=default-light

# Port for Pi-hole web interface (using 81 to reserve 80 for nginx proxy manager)
PIHOLE_WEBPORT=81

# --------------------------------------------
# Reverse DNS Configuration
# --------------------------------------------

# Enable reverse DNS server for local hostname resolution
REV_SERVER=true

# Local domain name for reverse DNS lookups
REV_SERVER_DOMAIN=scarlettlab.home

# IP address of your router/gateway (where reverse DNS queries are sent)
REV_SERVER_TARGET=192.168.3.1

# Network range in CIDR notation (e.g., 192.168.3.0/24 covers 192.168.3.1-254)
REV_SERVER_CIDR=192.168.3.0/24

# --------------------------------------------
# Network Configuration
# --------------------------------------------

# IP address of this Pi-hole server on your local network
# SERVER_IP=192.168.3.95
# SERVER_IP=192.168.3.125
SERVER_IP=192.168.2.28

# --------------------------------------------
# Advanced Settings
# --------------------------------------------

# Rate limiting: max queries per time period (format: queries/seconds)
# This prevents DNS abuse - allows 5000 queries per 60 seconds
RATE_LIMIT=5000/60

# Pi-hole verbosity level (0=minimal, 4=maximum debug output)
VERBOSE_LEVEL=0

# --------------------------------------------
# Debug Logging Flags
# Note: These create detailed logs useful for troubleshooting
# but will use more disk space
# --------------------------------------------

# Enable all debug logging categories
DEBUG_ALL=false

# Enable database operation logging
DEBUG_DATABASE=false

# Enable network connection logging
DEBUG_NETWORKING=false

# Enable EDNS0 (Extension Mechanisms for DNS) logging
DEBUG_EDNS0=false

# Enable DNS query logging with detailed information
DEBUG_QUERIES=false

# Enable Linux capabilities logging
DEBUG_CAPS=false
